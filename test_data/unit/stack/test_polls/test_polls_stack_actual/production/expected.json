    "NateNiteProductionPollsAccessLogQueriesQueryErrorsByDayC84FF977": {
      "Type": "AWS::Athena::NamedQuery",
      "Properties": {
        "Database": "nateniteproductionpolls_access_logs",
        "Name": "polls/errors-by-day",
        "QueryString": "SELECT \"date\", sc_status, x_edge_result_type, count(*) AS requests\nFROM nateniteproductionpolls_access_logs.cloudfront_logs\nWHERE year >= year(current_date - interval '30' day)\n  AND \"date\" >= cast(current_date - interval '30' day AS varchar)\n  AND cast(sc_status AS integer) >= 400\nGROUP BY 1, 2, 3\nORDER BY 1 DESC, 4 DESC",
        "WorkGroup": {
          "Ref": "NateNiteProductionPollsAccessLogQueriesWorkGroup8934E74A"
        }
      },
      "DependsOn": [
        "NateNiteProductionPollsAccessLogQueriesTableFDA6020C"
      ]
    },
    "NateNiteProductionPollsAccessLogQueriesQueryTopClientAddresses0A077BEA": {
      "Type": "AWS::Athena::NamedQuery",
      "Properties": {
        "Database": "nateniteproductionpolls_access_logs",
        "Name": "polls/top-client-addresses",
        "QueryString": "SELECT c_ip, count(*) AS requests,\n  count_if(sc_status = '403') AS blocked,\n  count_if(cast(sc_status AS integer) >= 400) AS rejected\nFROM nateniteproductionpolls_access_logs.cloudfront_logs\nWHERE year >= year(current_date - interval '7' day)\n  AND \"date\" >= cast(current_date - interval '7' day AS varchar)\nGROUP BY c_ip\nORDER BY requests DESC\nLIMIT 20",
        "WorkGroup": {
          "Ref": "NateNiteProductionPollsAccessLogQueriesWorkGroup8934E74A"
        }
      },
      "DependsOn": [
        "NateNiteProductionPollsAccessLogQueriesTableFDA6020C"
      ]
    },
    "NateNiteProductionPollsAccessLogQueriesQueryBlockedAndThrottled954628A6": {
      "Type": "AWS::Athena::NamedQuery",
      "Properties": {
        "Database": "nateniteproductionpolls_access_logs",
        "Name": "polls/blocked-and-throttled",
        "QueryString": "SELECT \"date\", \"time\", sc_status, cs_method, cs_uri_stem,\n  x_edge_detailed_result_type, c_ip\nFROM nateniteproductionpolls_access_logs.cloudfront_logs\nWHERE year >= year(current_date - interval '7' day)\n  AND \"date\" >= cast(current_date - interval '7' day AS varchar)\n  AND sc_status IN ('403', '429')\nORDER BY \"date\" DESC, \"time\" DESC\nLIMIT 100",
        "WorkGroup": {
          "Ref": "NateNiteProductionPollsAccessLogQueriesWorkGroup8934E74A"
        }
      },
      "DependsOn": [
        "NateNiteProductionPollsAccessLogQueriesTableFDA6020C"
      ]
    },
