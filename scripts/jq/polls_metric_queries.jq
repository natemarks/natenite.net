# The daily metric queries for `aws cloudwatch get-metric-data`.
#
# Arguments (jq --arg):
#   function      the submit function's name (generated by CloudFormation)
#   distribution  the polls distribution's ID (generated by CloudFormation)
#   account       the AWS account number
#   webacl        the shared web ACL's metric name; its real name carries a
#                 generated suffix, so it is matched as a search term
#
# The firewall rule queries cover the shared web ACL, which also protects the
# main site; the `polls` query is for this distribution alone. Every query uses
# a one-day period: finer data is only kept for a short time.
# Labels start with "count:" (days add up) or "rate:" (they do not).
def daily($id; $namespace; $name; $dimensions; $stat; $label):
  {
    Id: $id,
    Label: $label,
    MetricStat: {
      Metric: {
        Namespace: $namespace,
        MetricName: $name,
        Dimensions: $dimensions
      },
      Period: 86400,
      Stat: $stat
    }
  };

def function_dimensions: [{Name: "FunctionName", Value: $function}];
def distribution_dimensions: [
  {Name: "DistributionId", Value: $distribution},
  {Name: "Region", Value: "Global"}
];

[
  {
    Id: "waf_rules",
    Label: "count: shared firewall blocked requests, rule ${PROP('Dim.Rule')}",
    Expression: (
      "SEARCH('{AWS/WAFV2,Rule,WebACL} MetricName=\"BlockedRequests\" "
      + $webacl + "', 'Sum', 86400)"
    )
  },
  daily(
    "waf_polls"; "AWS/WAFV2"; "BlockedRequests";
    [
      {
        Name: "Resource",
        Value: "arn:aws:cloudfront::\($account):distribution/\($distribution)"
      },
      {Name: "ResourceType", Value: "CF"}
    ];
    "Sum"; "count: polls firewall blocked requests"
  ),
  daily(
    "lambda_invocations"; "AWS/Lambda"; "Invocations";
    function_dimensions; "Sum"; "count: function invocations"
  ),
  daily(
    "lambda_errors"; "AWS/Lambda"; "Errors";
    function_dimensions; "Sum"; "count: function errors"
  ),
  daily(
    "lambda_throttles"; "AWS/Lambda"; "Throttles";
    function_dimensions; "Sum"; "count: function throttles"
  ),
  daily(
    "cloudfront_requests"; "AWS/CloudFront"; "Requests";
    distribution_dimensions; "Sum"; "count: distribution requests"
  ),
  daily(
    "cloudfront_4xx"; "AWS/CloudFront"; "4xxErrorRate";
    distribution_dimensions; "Average"; "rate: distribution 4xx error percent"
  ),
  daily(
    "cloudfront_5xx"; "AWS/CloudFront"; "5xxErrorRate";
    distribution_dimensions; "Average"; "rate: distribution 5xx error percent"
  )
]
